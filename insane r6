local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local plr = Players.LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")
local hrp = char:WaitForChild("HumanoidRootPart")
local cam = workspace.CurrentCamera

---------------------------------------------------------
-- ANIMATE OVERRIDES
---------------------------------------------------------

local animate = char:WaitForChild("Animate")

animate.idle.Animation1.AnimationId = "rbxassetid://89195173312130"
animate.idle.Animation2.AnimationId = "rbxassetid://89195173312130"

animate.walk.WalkAnim.AnimationId = "rbxassetid://80536599755423"
animate.run.RunAnim.AnimationId  = "rbxassetid://80536599755423"

if animate:FindFirstChild("jump") then
    animate.jump.JumpAnim.AnimationId = "rbxassetid://77139090404184"
end

if animate:FindFirstChild("fall") then
    animate.fall.FallAnim.AnimationId = "rbxassetid://139390570947836"
end

if animate:FindFirstChild("sit") then
    animate.sit.SitAnim.AnimationId = "rbxassetid://89786372331582"
end

---------------------------------------------------------
-- RANDOM EMOTE LIST (P KEY) — TOP PRIORITY
---------------------------------------------------------

local randomList = {
    89676212115777,
    116571017721759,
    78240649545370
}

local randomTracks = {}
for _, id in ipairs(randomList) do
    local a = Instance.new("Animation")
    a.AnimationId = "rbxassetid://" .. id
    local t = hum:LoadAnimation(a)
    t.Priority = Enum.AnimationPriority.Action4 -- highest priority
    table.insert(randomTracks, t)
end

local currentRandomTrack = nil

---------------------------------------------------------
-- FLING (YOUR EXISTING WALKFLING)
---------------------------------------------------------

local walkflinging = false

local function startWalkFling()
    local Root = hrp
    local Humanoid = hum

    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    Humanoid.BreakJointsOnDeath = false

    RunService.Stepped:Connect(function()
        if walkflinging then
            Humanoid.Health = math.huge
            Humanoid.MaxHealth = math.huge
        end
    end)

    walkflinging = true
    Root.CanCollide = false

    task.spawn(function()
        while walkflinging and Root and Root.Parent do
            RunService.Heartbeat:Wait()
            local vel = Root.Velocity

            -- tuned-down version
            Root.Velocity = vel * 1500 + Vector3.new(0, 1500, 0)

            RunService.RenderStepped:Wait()
            Root.Velocity = vel

            RunService.Stepped:Wait()
            Root.Velocity = vel + Vector3.new(0, 0.05, 0)
        end
    end)
end

local function stopWalkFling()
    walkflinging = false
    if hrp then hrp.CanCollide = true end
end

---------------------------------------------------------
-- F‑KEY ANIMATION + FLOAT + FLING
---------------------------------------------------------

local fAnim = Instance.new("Animation")
fAnim.AnimationId = "rbxassetid://99023943575837"
local fTrack = hum:LoadAnimation(fAnim)
fTrack.Priority = Enum.AnimationPriority.Action4

local function floatUp()
    local startPos = hrp.CFrame
    local endPos = startPos + Vector3.new(0, 7, 0)
    local duration = 0.8
    local startTime = tick()

    while tick() - startTime < duration do
        local alpha = (tick() - startTime) / duration
        hrp.CFrame = startPos:Lerp(endPos, alpha)
        RunService.Heartbeat:Wait()
    end

    hrp.CFrame = endPos
end

---------------------------------------------------------
-- INPUT
---------------------------------------------------------

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    -----------------------------------------------------
    -- P: toggle random emote
    -----------------------------------------------------
    if input.KeyCode == Enum.KeyCode.P then
        if currentRandomTrack and currentRandomTrack.IsPlaying then
            currentRandomTrack:Stop()
            currentRandomTrack = nil
            return
        end

        local t = randomTracks[math.random(1, #randomTracks)]
        currentRandomTrack = t
        t:Play()
    end

    -----------------------------------------------------
    -- F: play anim, float up, then fling
    -----------------------------------------------------
    if input.KeyCode == Enum.KeyCode.F then
        fTrack:Play()

        -- disable movement
        local oldWalk = hum.WalkSpeed
        local oldJump = hum.JumpHeight

        hum.WalkSpeed = 0
        hum.JumpHeight = 0

        -- float up
        task.spawn(floatUp)

        -- activate fling
        startWalkFling()

        -- stop after 1 second
        task.delay(1, function()
            fTrack:Stop()
            hum.WalkSpeed = oldWalk
            hum.JumpHeight = oldJump
            stopWalkFling()
        end)
    end
end)

---------------------------------------------------------
-- FORCE JUMP ANIMATION WHILE FALLING
---------------------------------------------------------

local function forceJumpAnim()
    local j = animate.jump.JumpAnim
    if j then j:Play() end
end

hum.StateChanged:Connect(function(_, new)
    -- no jump override
end)

---------------------------------------------------------
-- MAIN LOOP
---------------------------------------------------------

RunService.Heartbeat:Connect(function()
    local state = hum:GetState()

    if state == Enum.HumanoidStateType.Jumping
        or state == Enum.HumanoidStateType.Freefall then
        forceJumpAnim()
    end
end)

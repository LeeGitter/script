local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local plr = Players.LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")
local hrp = char:WaitForChild("HumanoidRootPart")
local cam = workspace.CurrentCamera

---------------------------------------------------------
-- ANIMATE OVERRIDES (NORMAL MODE)
---------------------------------------------------------

local animate = char:WaitForChild("Animate")

local NORMAL_IDLE = "rbxassetid://89195173312130"
local NORMAL_WALK = "rbxassetid://80536599755423"
local NORMAL_RUN  = "rbxassetid://80536599755423"
local NORMAL_JUMP = "rbxassetid://77139090404184"
local NORMAL_FALL = "rbxassetid://139390570947836"
local NORMAL_SIT  = "rbxassetid://89786372331582"

animate.idle.Animation1.AnimationId = NORMAL_IDLE
animate.idle.Animation2.AnimationId = NORMAL_IDLE
animate.walk.WalkAnim.AnimationId = NORMAL_WALK
animate.run.RunAnim.AnimationId  = NORMAL_RUN
animate.jump.JumpAnim.AnimationId = NORMAL_JUMP
animate.fall.FallAnim.AnimationId = NORMAL_FALL
animate.sit.SitAnim.AnimationId = NORMAL_SIT

---------------------------------------------------------
-- RANDOM EMOTE LIST (P KEY) — TOP PRIORITY
---------------------------------------------------------

local randomList = {
    89676212115777,
    116571017721759,
    78240649545370
}

local randomTracks = {}
for _, id in ipairs(randomList) do
    local a = Instance.new("Animation")
    a.AnimationId = "rbxassetid://" .. id
    local t = hum:LoadAnimation(a)
    t.Priority = Enum.AnimationPriority.Action4
    table.insert(randomTracks, t)
end

local currentRandomTrack = nil

---------------------------------------------------------
-- INSANE MODE ANIMATIONS
---------------------------------------------------------

local INSANE_WALK = "rbxassetid://130072963359721"
local INSANE_RUN  = "rbxassetid://130072963359721"
local INSANE_JUMP = "rbxassetid://113732978397954"
local INSANE_FALL = "rbxassetid://113732978397954"

local insaneMode = false

local function applyInsaneAnimations()
    animate.walk.WalkAnim.AnimationId = INSANE_WALK
    animate.run.RunAnim.AnimationId  = INSANE_RUN
    animate.jump.JumpAnim.AnimationId = INSANE_JUMP
    animate.fall.FallAnim.AnimationId = INSANE_FALL
end

local function applyNormalAnimations()
    animate.walk.WalkAnim.AnimationId = NORMAL_WALK
    animate.run.RunAnim.AnimationId  = NORMAL_RUN
    animate.jump.JumpAnim.AnimationId = NORMAL_JUMP
    animate.fall.FallAnim.AnimationId = NORMAL_FALL
end

local function enterInsaneMode()
    insaneMode = true
    hum.WalkSpeed = 32
    hum.JumpHeight = 15
    applyInsaneAnimations()
end

local function exitInsaneMode()
    insaneMode = false
    hum.WalkSpeed = 16
    hum.JumpHeight = 7.2
    applyNormalAnimations()
end

---------------------------------------------------------
-- F‑KEY ANIMATION (TOGGLE INSANE MODE)
---------------------------------------------------------

local insaneAnim = Instance.new("Animation")
insaneAnim.AnimationId = "rbxassetid://112488881929977"
local insaneTrack = hum:LoadAnimation(insaneAnim)
insaneTrack.Priority = Enum.AnimationPriority.Action4

local function playFAnimation(callback)
    insaneTrack:Play()

    -- disable movement
    local oldWalk = hum.WalkSpeed
    local oldJump = hum.JumpHeight

    hum.WalkSpeed = 0
    hum.JumpHeight = 0

    task.delay(3, function()
        insaneTrack:Stop()
        callback()
    end)
end

---------------------------------------------------------
-- INPUT
---------------------------------------------------------

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    -----------------------------------------------------
    -- P: toggle random emote
    -----------------------------------------------------
    if input.KeyCode == Enum.KeyCode.P then
        if currentRandomTrack and currentRandomTrack.IsPlaying then
            currentRandomTrack:Stop()
            currentRandomTrack = nil
            return
        end

        local t = randomTracks[math.random(1, #randomTracks)]
        currentRandomTrack = t
        t:Play()
    end

    -----------------------------------------------------
    -- F: toggle insane mode
    -----------------------------------------------------
    if input.KeyCode == Enum.KeyCode.F then
        if insaneMode == false then
            -- F → INSANE MODE
            playFAnimation(function()
                enterInsaneMode()
            end)
        else
            -- F → EXIT INSANE MODE
            playFAnimation(function()
                exitInsaneMode()
            end)
        end
    end
end)

---------------------------------------------------------
-- FORCE JUMP ANIMATION WHILE FALLING
---------------------------------------------------------

local function forceJumpAnim()
    local j = animate.jump.JumpAnim
    if j then j:Play() end
end

hum.StateChanged:Connect(function(_, new)
    -- no jump override unless insane mode
end)

---------------------------------------------------------
-- MAIN LOOP
---------------------------------------------------------

RunService.Heartbeat:Connect(function()
    local state = hum:GetState()

    if state == Enum.HumanoidStateType.Jumping
        or state == Enum.HumanoidStateType.Freefall then
        forceJumpAnim()
    end
end)

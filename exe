local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local plr = Players.LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")
local hrp = char:WaitForChild("HumanoidRootPart")
local cam = workspace.CurrentCamera

-- Animation IDs
local ids = {
    idle   = 130912259300899,
    run    = 102622695004986,
    jump   = 4211219390,
    fall   = 656115606,
    spin   = 18537367238,
    laugh  = 127415121971326,
    flight = 99694231408564,
    appear = 90669505009197,
    mark   = 80372239811417
}

-- Load animations (all mid-high priority)
local anims = {}
for name, id in pairs(ids) do
    local a = Instance.new("Animation")
    a.AnimationId = "rbxassetid://" .. id
    local track = hum:LoadAnimation(a)
    track.Priority = Enum.AnimationPriority.Action
    anims[name] = track
end

local currentTrack
local function playAnim(name, speed)
    local t = anims[name]
    if not t then return end
    if currentTrack ~= t then
        if currentTrack then currentTrack:Stop() end
        currentTrack = t
        currentTrack:Play()
    end
    if speed then currentTrack:AdjustSpeed(speed) end
end

local function stopAll()
    for _, t in pairs(anims) do
        t:Stop()
    end
    currentTrack = nil
end

-- Movement settings
local minWalk = 5
local maxWalk = 25
local accel = (maxWalk - minWalk) / 5 -- ~5 seconds to max
hum.WalkSpeed = minWalk
hum.JumpHeight = 30

-- Airborne state
local airborne = false
hum.StateChanged:Connect(function(_, new)
    if new == Enum.HumanoidStateType.Jumping then
        airborne = true
    elseif new == Enum.HumanoidStateType.Landed then
        airborne = false
    end
end)

-- Sprint state
local sprinting = false
local sprintTimer = 0

-- Spin / dash / flight
local holdingE = false
local spinCharging = false
local chargeStart = 0

local dashActive = false
local dashEndTime = 0
local dashWalkSpeed = 35

local flightMode = false

-- Fling state (no ChangeState, no jump lock)
local walkflinging = false

local function startWalkFling()
    local Root = hrp
    local Humanoid = hum

    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    Humanoid.BreakJointsOnDeath = false

    RunService.Stepped:Connect(function()
        if walkflinging then
            Humanoid.Health = math.huge
            Humanoid.MaxHealth = math.huge
        end
    end)

    walkflinging = true
    Root.CanCollide = false

    spawn(function()
        while walkflinging and Root and Root.Parent do
            RunService.Heartbeat:Wait()
            local vel = Root.Velocity
            Root.Velocity = vel * 99999999 + Vector3.new(0, 99999999, 0)
            RunService.RenderStepped:Wait()
            Root.Velocity = vel
            RunService.Stepped:Wait()
            Root.Velocity = vel + Vector3.new(0, 0.1, 0)
        end
    end)
end

local function stopWalkFling()
    walkflinging = false
    if hrp then
        hrp.CanCollide = true
    end
end

local function startDash(charge)
    local alpha = math.clamp(charge / 3, 0, 1)
    local duration = 3 + 2 * alpha -- 3s → 5s
    dashEndTime = tick() + duration
    dashActive = true
    startWalkFling()
    -- keep spin playing during dash
    playAnim("spin", 3)
end

-- Targeting (R key)
local mouse = plr:GetMouse()
local targeting = false
local targetData = {}
local hoveredPlayer = nil

local function clearTargets()
    for _, data in pairs(targetData) do
        if data.highlight then data.highlight:Destroy() end
        if data.gui then data.gui:Destroy() end
    end
    targetData = {}
    hoveredPlayer = nil
end

local function enterTargetMode()
    targeting = true
    clearTargets()

    local mark = anims.mark
    if mark then
        mark.Looped = true
        mark:Play()
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= plr and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local head = p.Character:FindFirstChild("Head") or root
            if root and head then
                local h = Instance.new("Highlight")
                h.FillColor = Color3.fromRGB(255, 0, 0)
                h.FillTransparency = 0.5
                h.OutlineColor = Color3.fromRGB(255, 215, 0)
                h.Adornee = p.Character
                h.Parent = p.Character

                local bill = Instance.new("BillboardGui")
                bill.Size = UDim2.new(0, 40, 0, 40)
                bill.AlwaysOnTop = true
                bill.Adornee = head
                bill.Parent = p.Character

                local frame = Instance.new("Frame")
                frame.Size = UDim2.new(1, 0, 1, 0)
                frame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                frame.BackgroundTransparency = 0.5
                frame.Parent = bill

                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(1, 0)
                corner.Parent = frame

                targetData[p] = {highlight = h, gui = bill, frame = frame}
            end
        end
    end
end

local function exitTargetMode()
    targeting = false
    if anims.mark then anims.mark:Stop() end
    clearTargets()
end

mouse.Move:Connect(function()
    if not targeting then return end
    hoveredPlayer = nil

    local target = mouse.Target
    if target then
        local model = target:FindFirstAncestorOfClass("Model")
        if model then
            local p = Players:GetPlayerFromCharacter(model)
            if p and p ~= plr and targetData[p] then
                hoveredPlayer = p
            end
        end
    end

    for p, data in pairs(targetData) do
        if data.frame then
            if p == hoveredPlayer then
                data.frame.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
            else
                data.frame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            end
        end
    end
end)

mouse.Button1Down:Connect(function()
    if not targeting or not hoveredPlayer then return end
    local p = hoveredPlayer
    local ch = p.Character
    if not ch then return end
    local root = ch:FindFirstChild("HumanoidRootPart")
    if not root then return end

    exitTargetMode()

    -- laugh 0.5s, then teleport + appear 1s
    playAnim("laugh", 1)
    task.delay(0.5, function()
        stopAll()
        hrp.CFrame = root.CFrame + Vector3.new(0, 3, 0)
        playAnim("appear", 1)
        task.delay(1, function()
            stopAll()
        end)
    end)
end)

-- Input
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    if input.KeyCode == Enum.KeyCode.E then
        holdingE = true
        if not airborne then
            -- ground spin charge
            spinCharging = true
            chargeStart = tick()
            hum.WalkSpeed = 0
            playAnim("spin", 3)
        else
            -- midair flight
            flightMode = true
            playAnim("flight", 1)
        end

    elseif input.KeyCode == Enum.KeyCode.Q then
        -- laugh for 1 second
        playAnim("laugh", 1)
        task.delay(1, function()
            if currentTrack == anims.laugh then
                currentTrack:Stop()
                currentTrack = nil
            end
        end)

    elseif input.KeyCode == Enum.KeyCode.R then
        if targeting then
            exitTargetMode()
        else
            enterTargetMode()
        end
    end
end)

UserInputService.InputEnded:Connect(function(input, gpe)
    if gpe then return end

    if input.KeyCode == Enum.KeyCode.E then
        holdingE = false

        if spinCharging then
            spinCharging = false
            local charge = math.min(tick() - chargeStart, 3)
            startDash(charge)
            -- spin stays playing during dash
        end

        if flightMode then
            flightMode = false
            stopAll()
        end
    end
end)

-- Main loop
RunService.Heartbeat:Connect(function(dt)
    cam = workspace.CurrentCamera or cam
    local moving = hum.MoveDirection.Magnitude > 0.1
    local state = hum:GetState()

    -- Flight mode (midair E hold)
    if flightMode then
        if cam then
            local dir = cam.CFrame.LookVector
            hrp.AssemblyLinearVelocity = dir * 35
        end
        playAnim("flight", 1)
        return
    end

    -- Dash period: WalkSpeed locked to 35, fling active, spin playing
    if dashActive then
        if tick() >= dashEndTime then
            dashActive = false
            stopWalkFling()
            hum.WalkSpeed = minWalk
            stopAll()
        else
            hum.WalkSpeed = dashWalkSpeed
            playAnim("spin", 3)
        end
        return
    end

    -- Spin charging: no movement
    if spinCharging then
        hum.WalkSpeed = 0
        return
    end

    -- Sprint / run logic (only when not dash/flight/spin)
    if not sprinting then
        if moving then
            hum.WalkSpeed = math.clamp(hum.WalkSpeed + accel * dt, minWalk, maxWalk)
            if hum.WalkSpeed >= maxWalk - 0.01 then
                sprintTimer += dt
                if sprintTimer >= 3 then
                    sprinting = true
                    hum.WalkSpeed = 50
                end
            else
                sprintTimer = 0
            end
        else
            hum.WalkSpeed = minWalk
            sprintTimer = 0
        end
    else
        if not moving then
            sprinting = false
            sprintTimer = 0
            hum.WalkSpeed = minWalk
            stopAll()
        else
            hum.WalkSpeed = 50
            playAnim("flight", 5)
            return
        end
    end

    -- Base animations
    if state == Enum.HumanoidStateType.Jumping then
        playAnim("jump", 1)
    elseif state == Enum.HumanoidStateType.Freefall then
        playAnim("fall", 1)
    elseif moving then
        playAnim("run")
        local ws = hum.WalkSpeed
        local t = math.clamp((ws - minWalk) / (maxWalk - minWalk), 0, 1)
        if currentTrack then
            currentTrack:AdjustSpeed(1 + (5 - 1) * t)
        end
    else
        playAnim("idle", 1)
    end
end)

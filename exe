local plr = game.Players.LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")
local hrp = char:WaitForChild("HumanoidRootPart")
local rs = game:GetService("RunService")
local uis = game:GetService("UserInputService")
local cam = workspace.CurrentCamera

-- Animation IDs
local ids = {
    idle   = 130912259300899,
    run    = 102622695004986,
    jump   = 4211219390,
    fall   = 656115606,
    spin   = 18537367238,
    flight = 99694231408564
}

-- Load animations
local anims = {}
for name,id in pairs(ids) do
    local a = Instance.new("Animation")
    a.AnimationId = "rbxassetid://"..id
    local track = hum:LoadAnimation(a)
    track.Priority = Enum.AnimationPriority.Action
    anims[name] = track
end

local currentTrack
local function playAnim(name, speed)
    local t = anims[name]
    if not t then return end
    if currentTrack ~= t then
        if currentTrack then currentTrack:Stop() end
        currentTrack = t
        currentTrack:Play()
    end
    if speed then currentTrack:AdjustSpeed(speed) end
end

local function stopAll()
    for _,t in pairs(anims) do t:Stop() end
    currentTrack = nil
end

-- Movement settings
local minWalk = 5
local maxWalk = 25
local accel = (maxWalk - minWalk) / 5  -- ~5 seconds to reach max
hum.WalkSpeed = minWalk
hum.JumpHeight = 30

-- State flags
local airborne = false
hum.StateChanged:Connect(function(_, new)
    if new == Enum.HumanoidStateType.Jumping then
        airborne = true
    elseif new == Enum.HumanoidStateType.Landed then
        airborne = false
    end
end)

-- Spin / dash / flight
local holdingE = false
local spinCharging = false
local chargeStart = 0

local dashActive = false
local dashEndTime = 0
local dashDir = Vector3.new(0,0,0)
local dashSpeed = 50
local dashSteerHardness = 1

local flightMode = false

-- Fling flag
local flingActive = false

-- Your fling logic, wrapped so it only runs during dash
local function startFling()
    flingActive = true
    local Root = hrp
    local Humanoid = hum

    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    Humanoid.BreakJointsOnDeath = false

    spawn(function()
        while flingActive and Root and Root.Parent do
            RunService.Heartbeat:Wait()
            local vel = Root.Velocity
            Root.Velocity = vel * 99999999 + Vector3.new(0, 99999999, 0)
            RunService.RenderStepped:Wait()
            Root.Velocity = vel
            RunService.Stepped:Wait()
            Root.Velocity = vel + Vector3.new(0, 0.1, 0)
        end
    end)
end

local function stopFling()
    flingActive = false
end

local function startDash(charge)
    local alpha = math.clamp(charge / 3, 0, 1)

    dashSpeed = 50 * (1 + 0.5 * alpha)
    local duration = 3 + 2 * alpha
    dashEndTime = tick() + duration

    dashSteerHardness = 1 + 0.5 * alpha

    local look = cam.CFrame.LookVector
    local flat = Vector3.new(look.X,0,look.Z)
    if flat.Magnitude < 0.1 then
        flat = hum.MoveDirection.Magnitude > 0 and hum.MoveDirection or hrp.CFrame.LookVector
        flat = Vector3.new(flat.X,0,flat.Z)
    end
    dashDir = flat.Unit

    dashActive = true
    startFling()
end

-- Input
uis.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.E then
        holdingE = true

        if not airborne then
            spinCharging = true
            chargeStart = tick()
            hum.WalkSpeed = 0
            playAnim("spin", 3) -- 3x speed
        else
            flightMode = true
            playAnim("flight", 1)
        end
    end
end)

uis.InputEnded:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.E then
        holdingE = false

        if spinCharging then
            spinCharging = false
            stopAll()
            local charge = math.min(tick() - chargeStart, 3)
            startDash(charge)
            hum.WalkSpeed = minWalk
        end

        if flightMode then
            flightMode = false
            stopAll()
        end
    end
end)

-- Main loop
rs.Heartbeat:Connect(function(dt)
    cam = workspace.CurrentCamera or cam
    local moving = hum.MoveDirection.Magnitude > 0.1
    local state = hum:GetState()

    -- Flight mode
    if flightMode then
        local dir = cam.CFrame.LookVector
        hrp.AssemblyLinearVelocity = dir * 35
        playAnim("flight", 1)
        return
    end

    -- Dash mode
    if dashActive then
        if tick() >= dashEndTime then
            dashActive = false
            stopFling()
        else
            local look = cam.CFrame.LookVector
            local flat = Vector3.new(look.X,0,look.Z)
            if flat.Magnitude > 0.1 then flat = flat.Unit end

            local moveDir = hum.MoveDirection
            if moveDir.Magnitude > 0.1 then
                moveDir = Vector3.new(moveDir.X,0,moveDir.Z).Unit
                flat = (flat + moveDir).Unit
            end

            local steerFactor = 0.15 / dashSteerHardness
            dashDir = dashDir:Lerp(flat, steerFactor).Unit

            local vel = hrp.AssemblyLinearVelocity
            hrp.AssemblyLinearVelocity = Vector3.new(dashDir.X * dashSpeed, vel.Y, dashDir.Z * dashSpeed)
        end
        return
    end

    -- Spin charging (no movement)
    if spinCharging then
        hum.WalkSpeed = 0
        return
    end

    -- Normal running
    if moving then
        hum.WalkSpeed = math.clamp(hum.WalkSpeed + accel * dt, minWalk, maxWalk)
    else
        hum.WalkSpeed = minWalk
    end

    -- Animations
    if state == Enum.HumanoidStateType.Jumping then
        playAnim("jump", 1)
    elseif state == Enum.HumanoidStateType.Freefall then
        playAnim("fall", 1)
    elseif moving then
        playAnim("run")
        local ws = hum.WalkSpeed
        local t = math.clamp((ws - minWalk) / (maxWalk - minWalk), 0, 1)
        currentTrack:AdjustSpeed(1 + (5 - 1) * t)
    else
        playAnim("idle", 1)
    end
end)
